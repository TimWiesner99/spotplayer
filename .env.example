# SpotPlayer environment configuration
# Copy this file to .env and fill in real values.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-hex-string

# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
PASSWORD_HASH=$2b$12$examplehashgoesherepleasechangeme

# Absolute path where media files are stored (must be readable by nginx).
# Default: /data (mount your media drive here).
MEDIA_ROOT=/data

# Nginx internal location prefix used for X-Accel-Redirect (must match nginx.conf)
NGINX_INTERNAL_PREFIX=/internal/media

# SQLite database file path
DATABASE_PATH=./spotplayer.db
